#!/bin/sh

uci -q set firewall.@defaults[0].flow_offloading='0'
uci -q delete firewall.@defaults[0].flow_offloading_hw
uci -q set firewall.@defaults[0].fullcone='0'
uci -q delete firewall.@defaults[0].fullcone6

# Apply conservative firewall and DNS defaults. DNS redirect is a dnsmasq option, not a firewall option. Disable it for
# every configured dnsmasq instance so custom instances are covered too.
for section in $(uci -q show dhcp | sed -n "s/^dhcp\.\([^.=]*\)=dnsmasq$/\1/p"); do
	uci -q set "dhcp.$section.dns_redirect=0"
done

uci -q commit firewall
uci -q commit dhcp

exit 0
