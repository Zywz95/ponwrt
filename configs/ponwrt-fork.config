# Fork-specific overlay for both AN7581 and AN7583 targets.
# Upstream target config files remain untouched.

# Kernel BTF required by honk CO-RE eBPF.
CONFIG_KERNEL_DEBUG_INFO=y
CONFIG_KERNEL_DEBUG_INFO_BTF=y
# CONFIG_KERNEL_DEBUG_INFO_REDUCED is not set
CONFIG_PACKAGE_honk=y
CONFIG_PACKAGE_luci-lib-daeuniverse=y
CONFIG_PACKAGE_luci-app-honk=y
CONFIG_PACKAGE_luci-i18n-daeuniverse-zh-cn=y
CONFIG_PACKAGE_daeuniverse-repo=y
CONFIG_PACKAGE_vantage-repo=y
CONFIG_PACKAGE_vmlinux-btf-builtin=y
# CONFIG_PACKAGE_vmlinux-btf is not set
CONFIG_PACKAGE_v2ray-geoip=y
CONFIG_PACKAGE_v2ray-geosite=y
# CONFIG_PACKAGE_dae is not set
# CONFIG_PACKAGE_daed is not set
# CONFIG_PACKAGE_luci-app-dae is not set
# CONFIG_PACKAGE_luci-app-daed is not set

# Vantage theme and feeds which are build-only, not runtime snapshots.
CONFIG_PACKAGE_luci-app-vantage=y
CONFIG_PACKAGE_luci-i18n-vantage-zh-cn=y
CONFIG_PACKAGE_luci-theme-vantage=y
CONFIG_PACKAGE_luci-i18n-vantage-theme-zh-cn=y
# CONFIG_PACKAGE_luci-theme-argon is not set
# CONFIG_PACKAGE_luci-app-argon-config is not set

# These feeds are used to build packages but do not publish runtime snapshots
# at downloads.immortalwrt.org. Keep them out of generated distfeeds.list;
# custom user-space repositories are registered separately in the image.
# CONFIG_FEED_video is not set
# CONFIG_FEED_pon_drivers is not set
# CONFIG_FEED_pon_userspace is not set
# CONFIG_FEED_daeuniverse is not set
# CONFIG_FEED_vantage is not set
